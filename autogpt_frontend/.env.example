# Frontend App Environment (example)
REACT_APP_FRONTEND_URL=http://localhost:3000/
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_API_BASE=/api
REACT_APP_WS_URL=ws://localhost:8000/ws

# Node env passthrough for UI hints
REACT_APP_NODE_ENV=development

# Logging level: trace|debug|info|warn|error|silent
REACT_APP_LOG_LEVEL=info

# Health
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (either JSON or comma-separated k=v)
REACT_APP_FEATURE_FLAGS=newRuns=true,smartMode=false
REACT_APP_EXPERIMENTS_ENABLED=false

# Telemetry (no SDK; when true, telemetry features are considered disabled)
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Optional source maps flag (documented; CRA controls actual generation)
REACT_APP_ENABLE_SOURCE_MAPS=true

# Optional dev server port and trust proxy flags (documented)
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
