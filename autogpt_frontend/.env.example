# Frontend environment configuration for AutoGPT React app
# Copy this file to ".env" and set values appropriately. Do NOT commit real secrets.

# URLs
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_API_BASE=/api
REACT_APP_WS_URL=ws://localhost:8000/ws

# Runtime mode and build flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false

# Logging
REACT_APP_LOG_LEVEL=info

# Healthcheck
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON string or comma-separated key=true pairs)
# Example: {"newTaskUI":true,"betaRunner":false}
REACT_APP_FEATURE_FLAGS={"newTaskUI":false}

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
