# Frontend configuration (copy this file to .env and adjust for your environment)

# Public URLs
# Absolute URL where the frontend is served. Used to compute BrowserRouter basename.
REACT_APP_FRONTEND_URL=http://localhost:3000

# Backend base URL and API path. Combined to form API_ROOT (e.g., http://localhost:8000/api)
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_API_BASE=/api

# WebSocket endpoint used by the frontend for live updates (e.g., run logs)
REACT_APP_WS_URL=ws://localhost:8000/ws

# Environment and server behavior (note: CRA controls dev server; these are primarily informational)
# If set, displayed in the UI Sidebar footer; otherwise falls back to process.env.NODE_ENV
REACT_APP_NODE_ENV=development
# CRA build controls source maps; this flag is read by env loader but is a no-op for CRA behavior
REACT_APP_ENABLE_SOURCE_MAPS=true
# Port is informative; CRA dev server typically uses PORT rather than REACT_APP_PORT
REACT_APP_PORT=3000
# Whether to trust proxy headers; informative for documentation
REACT_APP_TRUST_PROXY=false

# Logging level for the in-app logger: trace|debug|info|warn|error|silent
REACT_APP_LOG_LEVEL=info

# Health check path mounted by the backend (default /health)
REACT_APP_HEALTHCHECK_PATH=/health

# Feature control
# Enable feature flags as JSON or comma-separated pairs. Examples:
# REACT_APP_FEATURE_FLAGS={"newRuns":true,"smartMode":false}
# REACT_APP_FEATURE_FLAGS=newRuns=true,smartMode=false
REACT_APP_FEATURE_FLAGS=

# Toggle experimental UI paths (boolean)
REACT_APP_EXPERIMENTS_ENABLED=false

# Telemetry control (no telemetry SDK is integrated; this flag disables any potential telemetry paths)
REACT_APP_NEXT_TELEMETRY_DISABLED=true
